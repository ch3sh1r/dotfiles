#!/usr/bin/env bash
set -euo pipefail

monitor="${1:-DSI-1}"
mode="${IIO_HYPRLAND_MODE:-1200x1920@60.0}"
position="${IIO_HYPRLAND_POSITION:-4760x3046}"
scale="${IIO_HYPRLAND_SCALE:-1.5}"
sensor="${IIO_HYPRLAND_SENSOR:-/sys/bus/iio/devices/iio:device0}"
threshold="${IIO_HYPRLAND_THRESHOLD:-700}"
poll_interval="${IIO_HYPRLAND_POLL_INTERVAL:-0.5}"

transform_for_orientation() {
    case "$1" in
        normal) printf '3' ;;
        left-up) printf '0' ;;
        bottom-up) printf '1' ;;
        right-up) printf '2' ;;
        *) return 1 ;;
    esac
}

read_orientation() {
    local x y

    x="$(<"$sensor/in_accel_x_raw")"
    y="$(<"$sensor/in_accel_y_raw")"

    if (( x > threshold )); then
        printf 'normal'
    elif (( x < -threshold )); then
        printf 'bottom-up'
    elif (( y > threshold )); then
        printf 'right-up'
    elif (( y < -threshold )); then
        printf 'left-up'
    else
        return 1
    fi
}

apply_orientation() {
    local orientation="$1" transform

    transform="$(transform_for_orientation "$orientation")" || return 0

    hyprctl eval "hl.monitor({ output = \"$monitor\", mode = \"$mode\", position = \"$position\", scale = $scale, transform = $transform }); hl.config({ input = { touchdevice = { output = \"$monitor\", transform = $transform }, tablet = { output = \"$monitor\", transform = $transform } } }); hl.exec_scheduled_prop_refresh_immediately()" >/dev/null || true
}

last_orientation=""

while true; do
    if orientation="$(read_orientation)" && [[ "$orientation" != "$last_orientation" ]]; then
        apply_orientation "$orientation"
        last_orientation="$orientation"
    fi

    sleep "$poll_interval"
done
