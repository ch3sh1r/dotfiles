#!/usr/bin/env bash
# Select a screen region, OCR it with tesseract, copy the text to clipboard.
# Adapted from omarchy's omarchy-capture-text-extraction.
#
# Requires: grim, slurp, tesseract (+ tesseract-data-<lang>), wl-clipboard, libnotify
# Optional: hyprpicker (freezes the screen during selection)
#
# Languages default to English + Russian; override with OCR_LANGS, e.g. OCR_LANGS=eng

set -euo pipefail

for cmd in grim slurp tesseract wl-copy notify-send; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: required command not found: $cmd" >&2
        exit 127
    fi
done

PID=""

cleanup_freeze() {
    if [[ -n $PID ]]; then
        kill "$PID" 2>/dev/null || true
    fi
}
trap cleanup_freeze EXIT

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z >/dev/null 2>&1 &
    PID=$!
    sleep .1
fi

SELECTION=$(slurp 2>/dev/null || true)
[[ -z $SELECTION ]] && exit 0

TEXT=$(grim -g "$SELECTION" - |
    tesseract stdin stdout --oem 1 --psm 6 -l "${OCR_LANGS:-eng+rus}" \
        --dpi 300 -c preserve_interword_spaces=1 2>/dev/null)

if [[ -z $TEXT ]]; then
    notify-send "OCR" "No text recognized in selection" -u low -t 3000
    exit 1
fi

printf "%s" "$TEXT" | wl-copy
notify-send "OCR" "Copied text from selection to clipboard" -t 3000
