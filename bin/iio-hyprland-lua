#!/usr/bin/env bash
set -euo pipefail

# Use the same panel settings as monitors.lua, including when started manually.
panel_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/modules/panel.lua"
panel_values="$(lua - "$panel_config" <<'LUA'
local panel = dofile(arg[1])
for _, field in ipairs({ "output", "mode", "position", "scale" }) do
    local value = assert(panel[field], "Missing panel setting: " .. field)
    print(value)
end
LUA
)"
mapfile -t panel <<< "$panel_values"

monitor="${1:-${panel[0]}}"
mode="${IIO_HYPRLAND_MODE:-${panel[1]}}"
position="${IIO_HYPRLAND_POSITION:-${panel[2]}}"
scale="${IIO_HYPRLAND_SCALE:-${panel[3]}}"
sensor="${IIO_HYPRLAND_SENSOR:-/sys/bus/iio/devices/iio:device0}"
threshold="${IIO_HYPRLAND_THRESHOLD:-700}"
poll_interval="${IIO_HYPRLAND_POLL_INTERVAL:-0.5}"

if [[ ! -r "$sensor/in_accel_x_raw" || ! -r "$sensor/in_accel_y_raw" ]]; then
    printf 'iio-hyprland-lua: accelerometer not found at %s\n' "$sensor" >&2
    exit 1
fi

if ! [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    printf 'iio-hyprland-lua: invalid scale: %s\n' "$scale" >&2
    exit 1
fi

lua_string() {
    local value="${1//\\/\\\\}"
    value="${value//\"/\\\"}"
    printf '"%s"' "$value"
}

output="$(lua_string "$monitor")"
mode_value="$(lua_string "$mode")"
position_value="$(lua_string "$position")"

transform_for_orientation() {
    case "$1" in
        normal) printf '3' ;;
        left-up) printf '0' ;;
        bottom-up) printf '1' ;;
        right-up) printf '2' ;;
        *) return 1 ;;
    esac
}

read_orientation() {
    local x y

    x="$(<"$sensor/in_accel_x_raw")"
    y="$(<"$sensor/in_accel_y_raw")"

    if (( x > threshold )); then
        printf 'normal'
    elif (( x < -threshold )); then
        printf 'bottom-up'
    elif (( y > threshold )); then
        printf 'right-up'
    elif (( y < -threshold )); then
        printf 'left-up'
    else
        return 1
    fi
}

apply_orientation() {
    local orientation="$1" transform

    transform="$(transform_for_orientation "$orientation")" || return 0

    hyprctl eval "hl.monitor({ output = $output, mode = $mode_value, position = $position_value, scale = $scale, transform = $transform }); hl.config({ input = { touchdevice = { output = $output, transform = $transform }, tablet = { output = $output, transform = $transform } } }); hl.exec_scheduled_prop_refresh_immediately()" >/dev/null ||
        printf 'iio-hyprland-lua: hyprctl eval failed for %s\n' "$orientation" >&2
}

last_orientation=""

while true; do
    if orientation="$(read_orientation)" && [[ "$orientation" != "$last_orientation" ]]; then
        apply_orientation "$orientation"
        last_orientation="$orientation"
    fi

    sleep "$poll_interval"
done
